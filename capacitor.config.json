{
  "appId": "com.avelut.app",
  "appName": "AVELUT",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#00000000",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#FFFFFF"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#FFFFFF"
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  }
}
