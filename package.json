{
  "name": "avelut",
  "private": true,
  "version": "5.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node server/qwen-ws-proxy.mjs",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm dev:proxy\"",
    "build": "vite build",
    "preview": "vite preview",
    "build:mobile": "vite build && npx cap sync android",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "postbuild": "node -e \"if(process.env.VERCEL || process.env.CI) { console.log('Skipping react-snap on CI/Vercel'); } else { try { require('child_process').execSync('react-snap', {stdio: 'inherit'}); } catch (e) { console.warn('react-snap skipped or failed (non-blocking):', e.message); } }\"",
    "postinstall": "patch-package"
  },
  "reactSnap": {
    "source": "dist",
    "include": [
      "/",
      "/about",
      "/contact",
      "/policy",
      "/terms",
      "/refill-credits",
      "/plans",
      "/delete-account"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/react": "^3.0.193",
    "@base-ui/react": "^1.5.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/text-recognition": "^8.2.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "@capawesome-team/capacitor-file-opener": "^8.0.1",
    "@capawesome/capacitor-app-update": "^8.0.3",
    "@capgo/capacitor-updater": "^8.50.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@pinecone-database/pinecone": "^7.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^6.0.191",
    "capacitor-plugin-send-intent": "^0.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "jeep-sqlite": "^2.8.0",
    "katex": "^0.16.25",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^9.0.1",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.8.1",
    "rehype-katex": "7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "6.0.0",
    "shadcn": "^4.8.2",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.4",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^5.0.0",
    "adm-zip": "^0.5.18",
    "autoprefixer": "^10.4.23",
    "concurrently": "^10.0.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.6",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-sitemap": "^0.8.2"
  }
}
